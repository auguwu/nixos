{
    "$schema": "vscode://schemas/settings/user",

    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[terraform-vars]": {
        "editor.defaultFormatter": "hashicorp.terraform"
    },
    "[opentofu-vars]": {
        "editor.defaultFormatter": "opentofu.vscode-opentofu"
    },
    "[dockercompose]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.insertSpaces": true,
        "editor.autoIndent": "advanced",
        "editor.tabSize": 2,
        "editor.quickSuggestions": {
            "other": "on",
            "comments": "off",
            "strings": "on"
        }
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[terraform]": {
        "editor.defaultFormatter": "hashicorp.terraform"
    },
    "[opentofu]": {
        "editor.defaultFormatter": "opentofu.vscode-opentofu"
    },
    "[starlark]": {
        "editor.defaultFormatter": "BazelBuild.vscode-bazel"
    },
    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml"
    },
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer"
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.quickSuggestions": {
            "other": "on",
            "comments": "on",
            "strings": "on"
        }
    },
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "[nix]": {
        "editor.defaultFormatter": "jnoortheen.nix-ide",
        "editor.tabSize": 2
    },
    "[gn]": {
        "editor.defaultFormatter": "google.gn"
    },
    "[c]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },

    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.parameterHints.enabled": false,
    "editor.inlineSuggest.enabled": true,
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.bracketPairColorization.enabled": false,
    "editor.fontFamily": "'JetBrains Mono', 'Geist Mono', Consolas, 'Courier New', monospace",
    "editor.fontSize": 18,
    "editor.minimap.enabled": false,
    "editor.detectIndentation": false,
    "editor.semanticHighlighting.enabled": false,
    "editor.stickyScroll.enabled": false,
    "editor.quickSuggestions": {
        "other": "on",
        "comments": "off",
        "strings": "off"
    },

    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.associations": {
        "flake.lock": "json",
        ".*-version": "plaintext"
    },

    "workbench.startupEditor": "none",
    "workbench.colorTheme": "Vitesse Dark",
    "workbench.iconTheme": "catppuccin-latte",

    "window.titleBarStyle": "custom",

    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.tabs.enabled": true,
    "terminal.integrated.fontSize": 16,

    "eslint.validate": [
        "typescript",
        "javascript",
        "typescriptreact",
        "javascriptreact",
        "html",
        "vue",
        "astro"
    ],
    "eslint.probe": [
        "typescript",
        "javascript",
        "typescriptreact",
        "javascriptreact",
        "html",
        "vue",
        "astro"
    ],

    "prettier.vueIndentScriptAndStyle": true,
    "prettier.requireConfig": true,

    "nix.enableLanguageServer": true,
    "nix.serverPath": "@nil@/bin/nil",
    "nix.serverSettings": {
        "nil": {
            "formatting": {
                "command": ["nix", "fmt", "--"]
            },
            "nix": {
                "binary": "@nix@/bin/nix",
                "maxMemoryMB": 16382,
                "flake": {
                    "autoArchive": true,
                    "autoEvalInputs": true
                }
            }
        }
    },

    "clang-format.executable": "@clang-tools@/bin/clang-format",

    "opentofu.experimentalFeatures.validateOnSave": true,
    "opentofu.languageServer.opentofu.path": "@tofu@/bin/tofu",
    "opentofu.languageServer.enable": true,
    "opentofu.languageServer.path": "@tofu-ls@/bin/tofu-ls",

    "powershell.powerShellDefaultVersion": "nixpkgs",
    "powershell.powerShellAdditionalExePaths": {
        "nixpkgs": "@powershell@/bin/pwsh"
    },

    "telemetry.telemetryLevel": "off",
    "update.mode": "none",
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "debug.javascript.codelens.npmScripts": "never",
    "git.timeline.showAuthor": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "typescript.updateImportsOnFileMove.enabled": "never",
    "security.workspace.trust.untrustedFiles": "open",
    "redhat.telemetry.enabled": false,
    "go.toolsManagement.autoUpdate": false,
    "go.toolsManagement.checkForUpdates": "off",
    "javascript.updateImportsOnFileMove.enabled": "never",
    "vs-kubernetes": {
        "vs-kubernetes.crd-code-completion": "enabled",
        "vs-kubernetes.helm-path": "@helm@/bin/helm"
    },
    "notebook.cellToolbarLocation": {
        "juypter-notebook": "left",
        "default": "right"
    }
}
